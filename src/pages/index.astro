---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
const featured = projects.filter((project) => project.featured);
const topics = [
  { id: '01', title: 'Compiler construction', detail: 'Parsing, syntax trees, language semantics, and code generation.' },
  { id: '02', title: 'LLVM & optimization', detail: 'Intermediate representations, analysis, and transformation passes.' },
  { id: '03', title: 'Simulation systems', detail: 'Entity-component systems, procedural worlds, and performance.' },
];
---
<BaseLayout title="Home">
  <section class="border-b border-line/70 py-20 md:py-28">
    <p class="mb-5 font-mono text-xs uppercase tracking-[0.2em] text-accent">Software engineering · Systems · Compilers</p>
    <h1 class="max-w-4xl text-5xl font-semibold leading-[1.12] tracking-tight sm:text-6xl md:text-7xl">
      Building things.<br />Breaking things.<br /><span class="text-accent">Understanding things.</span>
    </h1>
    <p class="mt-8 max-w-2xl text-base leading-8 text-muted md:text-lg">
      I'm Jarron, a software engineer exploring compilers, LLVM, C++ systems, and simulation engines.
      This is where I document the architecture, experiments, mistakes, and lessons behind my projects.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={`${base}projects/`} class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-bg transition hover:brightness-110">Explore projects ↗</a>
      <a href={`${base}writing/`} class="rounded-lg border border-line px-5 py-3 text-sm font-medium text-ink transition hover:border-accent/60">Read the journal</a>
    </div>
    <div class="mt-12 flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
      <span class="h-2 w-2 rounded-full bg-accent"></span>
      Currently building <span class="text-ink">MicroCC</span> and <span class="text-ink">OptForge</span>
    </div>
  </section>

  <section class="py-20" aria-labelledby="featured-heading">
    <div class="mb-9 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-accent">Selected work</p>
        <h2 id="featured-heading" class="text-3xl font-semibold tracking-tight">Featured projects</h2>
      </div>
      <a href={`${base}projects/`} class="text-sm text-muted hover:text-accent">All projects ↗</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="border-t border-line/70 py-20" aria-labelledby="topics-heading">
    <p class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-accent">Inside the journal</p>
    <h2 id="topics-heading" class="mb-4 text-3xl font-semibold tracking-tight">What I'm documenting</h2>
    <p class="mb-9 max-w-2xl leading-7 text-muted">Not just what a program does, but how it works and why particular design decisions matter.</p>
    <div class="grid gap-4 md:grid-cols-3">
      {topics.map((topic) => (
        <div class="rounded-xl border border-line/70 p-5">
          <span class="font-mono text-xs text-accent">{topic.id}</span>
          <h3 class="mb-2 mt-5 text-lg font-medium">{topic.title}</h3>
          <p class="text-sm leading-7 text-muted">{topic.detail}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
