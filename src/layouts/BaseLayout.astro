---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title: string; description?: string; }
const {
  title,
  description = 'Technical notes on compilers, C++, LLVM, virtual machines, and simulation systems.',
} = Astro.props;
const fullTitle = title === 'Home' ? 'Jarron — Development Notes' : `${title} | Jarron — Development Notes`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1016" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen antialiased">
    <div class="flex min-h-screen flex-col">
      <SiteHeader />
      <main class="mx-auto w-full max-w-6xl flex-1 px-5 md:px-8">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
