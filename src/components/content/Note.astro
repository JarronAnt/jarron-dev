---
interface Props { kind?: 'note' | 'tip' | 'warning'; title?: string; }
const { kind = 'note', title = kind === 'tip' ? 'Tip' : kind === 'warning' ? 'Watch out' : 'Note' } = Astro.props;
---
<aside
  class:list={[
    'not-prose my-8 rounded-xl border p-5',
    kind === 'warning' ? 'border-amber-500/40 bg-amber-500/10' : 'border-accent/35 bg-accent/5',
  ]}
  aria-label={title}
>
  <p class:list={['mb-2 font-mono text-xs font-semibold uppercase tracking-widest', kind === 'warning' ? 'text-amber-300' : 'text-accent']}>{title}</p>
  <div class="text-sm leading-7 text-ink/90"><slot /></div>
</aside>
