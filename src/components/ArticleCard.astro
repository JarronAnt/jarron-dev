---
import type { BlogPost } from '../lib/blog';
import { formatDate, getReadingMinutes, postPath, tagPath } from '../lib/blog';

interface Props { post: BlogPost; compact?: boolean; }
const { post, compact = false } = Astro.props;
const { title, description, publishedAt, tags, project } = post.data;
---
<article
  class:list={[
    'group flex h-full flex-col rounded-2xl border border-line bg-surface/50 transition-colors hover:border-accent/50',
    compact ? 'p-5' : 'p-6 md:p-7',
  ]}
  data-post-card
  data-search={`${title} ${description} ${tags.join(' ')} ${project ?? ''}`.toLowerCase()}
  data-tags={tags.join('|')}
>
  <div class="mb-4 flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
    <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    <span aria-hidden="true">·</span>
    <span>{getReadingMinutes(post.body)} min read</span>
  </div>
  <h3 class:list={['font-semibold leading-snug tracking-tight text-ink group-hover:text-accent', compact ? 'text-lg' : 'text-xl md:text-2xl']}>
    <a href={postPath(post)} class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">{title}</a>
  </h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-muted">{description}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <a href={tagPath(tag)} class="rounded-md border border-line px-2.5 py-1 font-mono text-[11px] text-muted transition-colors hover:border-accent/50 hover:text-accent">{tag}</a>
    ))}
  </div>
  <a href={postPath(post)} class="mt-6 w-fit text-sm font-medium text-accent hover:underline">Read article ↗</a>
</article>
